{
  "name": "@redrob-labs/ui",
  "version": "1.0.12",
  "description": "The Redrob Group Design System 2026, as typed React components",
  "keywords": [
    "react",
    "components",
    "ui",
    "typescript",
    "design-system",
    "redrob"
  ],
  "author": "Janghoon Lee (Redrob)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/redrob-labs/redrob-ui"
  },
  "bugs": {
    "url": "https://github.com/redrob-labs/redrob-ui/issues"
  },
  "homepage": "https://github.com/redrob-labs/redrob-ui#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "dist/styles/*.css"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && mkdir -p dist/styles dist/fonts && cp src/styles/*.css dist/styles/ && cp src/fonts/*.woff2 dist/fonts/",
    "test": "node tools/parity/run.js --quiet",
    "test:self": "node tools/parity/run.js --self --quiet",
    "icons": "node tools/generate/icons.js",
    "icons:check": "node tools/generate/icons.js --check",
    "docs": "yarn build && node tools/docs/build.js",
    "docs:check": "yarn build && node tools/docs/build.js --check",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.8.9",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}
