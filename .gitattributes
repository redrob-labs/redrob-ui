# LF in every working copy, whatever core.autocrlf says. The parity harness reads the reference
# bundle's first line as JSON and the icon generator matches its lines exactly, so a CRLF checkout
# on Windows broke both, and the generated tokens.json differed only in line endings.
* text=auto eol=lf
*.woff2 binary
*.png binary
*.jpg binary
*.ico binary
# The app icons are a delivery's files, kept byte for byte so their sha256 in manifest.json holds.
src/brand/app-icons/**/*.svg -text
