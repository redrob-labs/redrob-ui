{
  "name": "@mckinley-and-rice/redrob-ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/mckinley-and-rice/redrob-ui"
  },
  "bugs": {
    "url": "https://github.com/mckinley-and-rice/redrob-ui/issues"
  },
  "homepage": "https://github.com/mckinley-and-rice/redrob-ui#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "dist/assets",
    "dist/style",
    "tailwind.config.js"
  ],
  "version": "1.0.12",
  "description": "React component library built with TypeScript and Tailwind CSS",
  "keywords": [
    "react",
    "components",
    "ui",
    "typescript",
    "tailwindcss",
    "storybook"
  ],
  "author": "Janghoon Lee (McKinley and Rice)",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.2",
    "@babel/preset-env": "^7.23.2",
    "@babel/preset-react": "^7.22.15",
    "@chromatic-com/storybook": "^3.2.3",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/addon-onboarding": "^8.4.7",
    "@storybook/addon-postcss": "^2.0.0",
    "@storybook/addon-webpack5-compiler-swc": "^2.0.0",
    "@storybook/blocks": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-webpack5": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "@types/node": "^20.8.9",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^9.1.3",
    "clsx": "^2.0.0",
    "css-loader": "^6.8.1",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.4.49",
    "sonner": "^1.7.1",
    "storybook": "^8.4.7",
    "style-loader": "^3.3.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "echo \"No test suite in this repository. See CONTRIBUTING.md for how a change is verified.\" && exit 1",
    "build": "tsc && mkdir -p dist/style dist/assets && cp -r src/style/. dist/style/ && cp -r src/assets/. dist/assets/",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:clean": "rm -rf node_modules/.cache/storybook"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
